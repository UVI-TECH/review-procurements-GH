# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.

# Entorno: desarrollo (Fedora), produccion (PC de Gestión Humana) o validacion (solo lectura).
DJANGO_SETTINGS_MODULE=config.settings.desarrollo

# Obligatoria. Genera una con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Clave de la API de Anthropic (desde la Fase 2). Puede quedar vacía con MOTOR_SIMULADO=True.
# En desarrollo, una clave exclusiva de desarrollo; nunca la de producción de Gestión Humana.
ANTHROPIC_API_KEY=

# Clave de cifrado de los respaldos (desde la Fase 6). Se custodia aparte.
CLAVE_RESPALDO=

# True: respuestas simuladas, sin llamar a la API. Por defecto True en desarrollo y False en producción.
MOTOR_SIMULADO=True

# Carpeta de Contrataciones, con una subcarpeta por profesor.
# - En DESARROLLO: SIEMPRE una carpeta SINTÉTICA (PDFs de prueba, cédulas ficticias),
#   nunca datos reales de Gestión Humana.
# - Los datos reales solo se procesan en el clon de validación (fuera de este
#   repositorio, donde nunca se abre Claude Code) y en el PC de Gestión Humana.
CARPETA_CONTRATACIONES=

# Ruta de la base de datos. NUNCA dentro de una carpeta de OneDrive: la sincronización
# la corrompe. La app no arranca si queda dentro de CARPETA_CONTRATACIONES.
# Por defecto: revision.db en la raíz del proyecto.
RUTA_BASE_DATOS=

# Opcionales
# DJANGO_DEBUG=True
# MODELO_CLAUDE=claude-haiku-4-5-20251001
# RUTA_BLOQUEO_WORKER=/ruta/a/worker.lock     (por defecto, junto a la base de datos)
# MOTOR_PRECIO_ENTRADA_MTOK=1.0               (USD por millón de tokens, para --en-seco)
# MOTOR_PRECIO_SALIDA_MTOK=5.0
