{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["gh *", "git push*", "git fetch*", "git pull*", "git ls-remote*"],
    "network": {
      "allowedDomains": ["pypi.org", "files.pythonhosted.org", "github.com"]
    },
    "filesystem": {
      "allowWrite": ["~/.cache/uv", "~/.cache/pre-commit"]
    }
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.desarrollo)",
      "Read(**/.env.produccion)",
      "Read(**/.env.validacion)",
      "Read(**/.env.pruebas)",
      "Read(**/.env.dev)",
      "Read(**/.env.prod)",
      "Read(**/.env.bak)",
      "Read(**/.env.backup)",
      "Read(**/.env.old)",
      "Read(**/*.db)",
      "Read(**/*.db-*)",
      "Read(**/*.sqlite3)",
      "Read(**/*.sqlite3-*)",
      "Read(**/respaldos/**)",
      "Read(**/*.zip)",

      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(*.env\"*)",
      "Bash(*.env'*)",
      "Bash(*.env)*)",
      "Bash(*.env.local*)",
      "Bash(*.env.desarrollo*)",
      "Bash(*.env.produccion*)",
      "Bash(*.env.validacion*)",
      "Bash(*.env.pruebas*)",
      "Bash(*.env.dev*)",
      "Bash(*.env.prod*)",
      "Bash(*.env.bak*)",
      "Bash(*.env.backup*)",
      "Bash(*.env.old*)",
      "Bash(*printenv*)",
      "Bash(env)",
      "Bash(*.db)",
      "Bash(*.db *)",
      "Bash(*.db\"*)",
      "Bash(*.db'*)",
      "Bash(*.db)*)",
      "Bash(*.db-*)",
      "Bash(*.sqlite3*)",
      "Bash(sqlite3 *)",
      "Bash(*respaldos/*)",
      "Bash(*.zip*)",
      "Bash(unzip *)",
      "Bash(7z *)",
      "Bash(*manage.py dbshell*)",
      "Bash(*manage.py importar_respaldo*)",
      "Bash(*manage.py restaurar_respaldo*)"
    ]
  }
}
